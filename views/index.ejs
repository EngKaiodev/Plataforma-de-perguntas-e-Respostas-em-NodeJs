<%- include('partials/header') %>

    <body>
        <%- include('partials/navbar') %>


            <div class="container">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

                    <div>
                        <h1 class="fw-bold text-dark mb-1">
                            <i class="bi bi-chat-square-text text-primary"></i>
                            Faça sua pergunta
                        </h1>

                        <p class="text-muted mb-0">
                            Compartilhe suas dúvidas e ajude a comunidade a trocar conhecimentos.
                        </p>
                    </div>

                    <a href="/perguntar" class="btn btn-primary btn-lg shadow-sm">
                        <i class="bi bi-plus-circle me-1"></i>
                        Perguntar
                    </a>

                </div>

                <hr class="mb-4">
                <% perguntas.forEach(pergunta=> { %>

                    <div class="card shadow-sm border-0 rounded-3 mb-3">

                        <div class="card-body p-4">
                            <h4 class="card-title mb-0 fw-semibold text-dark">
                                <%= pergunta.titulo %>
                            </h4>
                        </div>

                        <div class="card-footer bg-white border-0 px-4 pb-3">
                            <a href="/pergunta/<%= pergunta.id %>" class="btn btn-primary">
                                <i class="bi bi-chat-dots"></i> Responder
                            </a>
                        </div>

                    </div>

                    <% }) %>

            </div>

    </body>
    <%- include('partials/footer') %>